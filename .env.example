# ==============================================================================
# Bitbucket Server MCP Configuration
# ==============================================================================

# Required: Bitbucket Server or Data Center base URL (no trailing slash)
BITBUCKET_URL=https://bitbucket.yourcompany.com

# Optional: Server-wide fallback Personal Access Token (PAT)
# If provided, requests without an Authorization header will use this token.
# If left blank, clients MUST send their own PAT via 'Authorization: Bearer <PAT>' header.
BITBUCKET_TOKEN=your-bitbucket-pat-token

# Optional: Default Bitbucket project key (e.g., PROJ) when not specified in tool calls
BITBUCKET_DEFAULT_PROJECT=

# Optional: Restrict server strictly to read-only operations (true / false)
BITBUCKET_READ_ONLY=false

# Optional: Max diff lines to display per file (set 0 for unlimited)
BITBUCKET_DIFF_MAX_LINES_PER_FILE=

# Optional: Custom headers sent to Bitbucket (e.g. for Zero Trust / Cloudflare Access)
# Format: Header1=Value1,Header2=Value2
BITBUCKET_CUSTOM_HEADERS=

# ==============================================================================
# MCP Server Transport Settings
# ==============================================================================

# Transport mode: 'http' for remote streaming HTTP/SSE or 'stdio' for CLI/desktop
MCP_TRANSPORT=http

# HTTP port to listen on and map
PORT=3000

