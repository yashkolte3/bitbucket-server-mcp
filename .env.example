# ==============================================================================
# Bitbucket Server MCP - Production Environment Configuration
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BITBUCKET INSTANCE SETTINGS (Required)
# ------------------------------------------------------------------------------
# The base URL of your Bitbucket Server or Data Center instance (without trailing slash).
# Example: https://bitbucket.internal.yourcompany.com
BITBUCKET_URL=https://bitbucket.yourcompany.com

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & CREDENTIAL FALLBACK HIERARCHY
# ------------------------------------------------------------------------------
# The server resolves credentials using the following priority order:
#   Priority 1: Client HTTP Header 'Authorization: Bearer <token>'
#   Priority 2: Client HTTP Header 'X-Bitbucket-Token: <token>'
#   Priority 3: Server Environment Variable 'BITBUCKET_TOKEN' (below)
#   Priority 4: Server Environment Variables 'BITBUCKET_USERNAME' + 'BITBUCKET_PASSWORD'
#   Fallback:   If none are provided, a 401 Unauthorized JSON-RPC error is returned.
#
# DEPLOYMENT MODEL A: Zero-Trust Multi-Tenant (RECOMMENDED for Team Deployments)
# Leave BITBUCKET_TOKEN empty. Each developer's AI client (Claude, Cursor, etc.)
# will supply their personal PAT via HTTP headers. Actions (PRs, comments, merges)
# are attributed to the individual developer, with zero credential sharing.
#
# DEPLOYMENT MODEL B: Shared Service Account (Single Bot / Automation)
# Provide a bot PAT below. Clients without their own token will fall back to this.
# Clients who pass their own Authorization header will override this token.
BITBUCKET_TOKEN=

# Alternative Basic Auth fallback (used only if BITBUCKET_TOKEN is empty and client provides no token):
# BITBUCKET_USERNAME=
# BITBUCKET_PASSWORD=

# ------------------------------------------------------------------------------
# 3. PROJECT & REPOSITORY DEFAULTS
# ------------------------------------------------------------------------------
# Default Bitbucket project key (e.g. CORE, PROJ).
# Used when a client calls project-level tools without explicitly specifying 'project'.
# If left empty, tools will require 'project' to be specified explicitly in tool calls.
BITBUCKET_DEFAULT_PROJECT=

# ------------------------------------------------------------------------------
# 4. SAFETY & ACCESS CONTROLS
# ------------------------------------------------------------------------------
# Set to 'true' to strictly enforce read-only mode.
# When true, all mutating tools (create PR, merge, comment, approve, delete) are
# disabled at protocol level. Safe for production exploration and auditing.
BITBUCKET_READ_ONLY=false

# Maximum number of diff lines to return per file in get_diff.
# Prevents large generated files or minified bundles from exhausting client context.
# Default is unlimited if left empty. Can be overridden per-call via maxLinesPerFile.
BITBUCKET_DIFF_MAX_LINES_PER_FILE=500

# ------------------------------------------------------------------------------
# 5. ENTERPRISE PROXIES, ZERO TRUST & TLS
# ------------------------------------------------------------------------------
# Custom HTTP headers sent to Bitbucket on every API request.
# Comma-separated list of Name=Value pairs.
# Useful for Cloudflare Access service tokens, corporate reverse proxies, or gateway auth.
# Example: CF-Access-Client-Id=xxx,CF-Access-Client-Secret=yyy,X-Forwarded-Host=mcp.local
BITBUCKET_CUSTOM_HEADERS=

# If your internal Bitbucket instance uses enterprise / self-signed TLS certificates:
# Pass the certificate path into the container, or disable TLS strict rejection:
# NODE_EXTRA_CA_CERTS=/certs/internal-ca.crt
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Custom path for Winston structured log file (defaults to ~/.bitbucket-server-mcp/bitbucket.log)
# BITBUCKET_LOG_PATH=/var/log/bitbucket-mcp/server.log

# ------------------------------------------------------------------------------
# 6. SERVER TRANSPORT SETTINGS
# ------------------------------------------------------------------------------
# Transport protocol:
#   'http'  - Standard MCP Streamable HTTP transport with SSE (for Docker/remote)
#   'stdio' - Standard I/O (for local desktop CLI execution)
MCP_TRANSPORT=http

# Host interface to bind to (0.0.0.0 listens on all interfaces inside Docker)
HOST=0.0.0.0

# HTTP port to listen on inside the container
PORT=3000
